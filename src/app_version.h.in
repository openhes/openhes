////////////////////////////////////////////////////////////////////////////////
/// @file
/// @brief Version and product strings, substituted at configure time.
///
/// @details
/// CMake's configure_file() replaces the @...@ placeholders from the project
/// version and the CMakeLists variables, so the binary can name itself
/// (src/cli/cmd_info.c, src/cli/cmd_help.c) without a generated C file.

#ifndef OPENHES_SRC_APP_VERSION_H
#define OPENHES_SRC_APP_VERSION_H

#define APP_VER_MAJOR @APP_VERSION_MAJOR@
#define APP_VER_MINOR @APP_VERSION_MINOR@
#define APP_VER_PATCH @APP_VERSION_PATCH@
#define APP_VER_TAG "@APP_VERSION_TAG@"

#define APP_NAME "@APP_NAME@"
#define APP_COMPANY_NAME "@COMPANY_NAME@"
#define APP_FILE_DESC "@FILE_DESC@"
#define APP_INTERNAL_NAME "@INTERNAL_NAME@"
#define APP_LEGAL_COPYRIGHT "@LEGAL_COPYRIGHT@"
#define APP_ORIGINAL_FILE_NAME "@ORIGINAL_FILE_NAME@"
#define APP_PRODUCT_NAME "@PRODUCT_NAME@"

#endif // #ifndef OPENHES_SRC_APP_VERSION_H
